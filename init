#!/bin/bash

echo "#ISPConfig inherited variables" >/etc/environment.ispconfig;
# Quote values so lists like isp_php_versions_available stay intact
env | awk -F= '/^isp_/ {
  key=$1; val=substr($0, index($0,"=")+1);
  gsub(/'\''/, "'\''\\'\'''\''", val);
  printf "%s='\''%s'\''\n", key, val;
}' >>/etc/environment.ispconfig;
chmod 0600 /etc/environment.ispconfig;

vars=`env | awk -F '=' '/^isp_/ {print $1}'`;
for var in $vars;
do
   export $var=;
   unset $var;
done;

exec /lib/systemd/systemd "$@";
